[Unit]
Description=Sehaty — personal health agent (MCP)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sehaty
Group=sehaty
WorkingDirectory=/var/lib/sehaty
ExecStart=/usr/local/bin/sehaty
Restart=always
RestartSec=15

# The key is read from a file, not an environment variable — an env var is visible in
# /proc/<pid>/environ and in systemctl show. 0400, owned by the service user.
Environment=SEHATY_KEY_FILE=/etc/sehaty/key
Environment=SEHATY_DB=/var/lib/sehaty/sehaty.db
Environment=SEHATY_MEDIA_DIR=/var/lib/sehaty/media
Environment=SEHATY_EXERCISES=/var/lib/sehaty/exercises.json
Environment=SEHATY_MCP_HOST=127.0.0.1
Environment=SEHATY_MCP_PORT=8765

# Hardening. Cheap here because the service needs one directory and one port.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sehaty
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryDenyWriteExecute=true

StandardOutput=append:/var/log/sehaty.log
StandardError=append:/var/log/sehaty.log

[Install]
WantedBy=multi-user.target
